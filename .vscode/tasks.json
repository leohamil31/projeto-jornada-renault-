{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iniciar front-end",
            "type": "shell",
            "command": "if not exist node_modules (npm install) & npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "npm run dev|vite",
                    "endsPattern": "Local:"
                }
            },
            "presentation": { "reveal": "always", "panel": "dedicated" }
        }
    ]
}
